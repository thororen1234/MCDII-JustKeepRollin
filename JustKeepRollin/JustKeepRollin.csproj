<Project Sdk="NeoRuneExtended.Sdk/0.4.1">
  <!--
    dotnet build compiles the mod and installs it into the game's Paks\~mods\JustKeepRollin folder.
    Close the game before building: it locks the mod files while running.
    If the game isn't found automatically, set NeoRuneGameDir in JustKeepRollin.csproj.user:
      <Project><PropertyGroup><NeoRuneGameDir>D:\XboxGames\Minecraft Dungeons II\Content</NeoRuneGameDir></PropertyGroup></Project>
  -->
  <PropertyGroup>
    <Version>1.0.2</Version>
    <NeoRuneModTitle>Just Keep Rollin</NeoRuneModTitle>
    <NeoRuneModDescription>Roll in mid-air.</NeoRuneModDescription>
  </PropertyGroup>
</Project>
